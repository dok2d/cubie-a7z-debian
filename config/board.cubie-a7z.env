# Cubie A7Z (Allwinner A733 / sun60iw2p1) board configuration.
#
# Kernel source: orangepi-build BSP track on 6.6.x. Allwinner ported their
# BSP forward from 5.15 to 6.6; orangepi-xunlong carries it with a working
# sun60iw2 defconfig. Not mainline — the BSP keeps CONFIG_AW_BSP=y and
# proprietary in-tree drivers.
#
# IMPORTANT: orangepi-build targets the Orange Pi 4 Pro, not the Cubie A7Z.
# SoC is identical (A733), but DTS, PMIC wiring, and WiFi/BT module differ.
# We reuse the orangepi defconfig and kernel patch set, then bring our own
# device tree for A7Z (backported from the Radxa 5.15 vendor tree or forked
# from the orangepi4pro DTS — to be resolved in stage 5).
#
# All commit SHAs MUST be filled in before running the fetcher. Branch names
# without SHAs are not acceptable — they move and break reproducibility.
# Resolve once with `git ls-remote <repo> <branch>` and paste the SHA here.

BOARD="cubie-a7z"
SOC="a733"
SOC_PLATFORM="sun60iw2p1"

# --- Kernel (orangepi-build BSP 6.6 track) ---
# orangepi-build is the meta-build repo. We do NOT use its build.sh end-to-end
# (it builds Orange Pi images, not Cubie). We pull it for:
#   - kernel defconfig:  external/config/kernel/linux-sun60iw2-current-a733.config
# Note: as of the pinned commit, orangepi-build carries no sun60iw2 kernel or
# U-Boot patches under external/patch/. Local patches go into patches/kernel/.
ORANGEPI_BUILD_REPO="https://github.com/orangepi-xunlong/orangepi-build.git"
ORANGEPI_BUILD_BRANCH="next"
ORANGEPI_BUILD_COMMIT="7f776a209b72b92e8c6a06abc83b1e7597eef5af"

# Actual kernel sources. orangepi-build clones these during its own run; we
# pin them directly. Resolve the exact repo+branch by reading
# external/sources/families/sun60iw2.conf in the orangepi-build checkout.
KERNEL_REPO="https://github.com/orangepi-xunlong/linux-orangepi.git"
KERNEL_BRANCH="orange-pi-6.6-sun60iw2"   # verified against sun60iw2.conf
KERNEL_COMMIT="8a9be72c9006a87f786736b3aa4e2dfd971c1429"
KERNEL_DEFCONFIG="sun60iw2-current-a733_defconfig"
KERNEL_DTB="sun60iw2-a733-cubie-a7z.dtb"  # we ship our own DTS

# --- Bootloader (vendor brandy-2.0 on A733) ---
# Mainline U-Boot does NOT support A733 as of 2026-05. brandy-2.0 with
# U-Boot 2018.07 is the only working path.
UBOOT_REPO="https://github.com/orangepi-xunlong/u-boot-orangepi.git"
UBOOT_BRANCH="v2018.05-sun60iw2"          # verified against sun60iw2.conf
UBOOT_COMMIT="b791be842935b27268ae3d00e943a9075495f30a"

# --- Allwinner BSP layers (boot pack + per-SoC configs) ---
# Same Radxa BSP set as before — orangepi-build references the same Allwinner
# AIOT source bundles for boot0/SPL/sboot. Switch to orangepi mirrors if you
# prefer their commit cadence; Radxa's tree is fine.
BSP_REPO="https://github.com/radxa/allwinner-bsp.git"
BSP_BRANCH="cubie-aiot-v1.4.6"
BSP_COMMIT="2045a3ca2a01f088c0314dc924bda59d154e363e"

TARGET_REPO="https://github.com/radxa/allwinner-target.git"
TARGET_BRANCH="target-a733-v1.4.6"
TARGET_COMMIT="cd3053fae98012a1343d9843c8b58c1e4efbda7f"

DEVICE_REPO="https://github.com/radxa/allwinner-device.git"
DEVICE_BRANCH="device-a733-v1.4.6"
DEVICE_COMMIT="79d54f44e14111db3845096cef0639a6c9222707"

# --- WiFi driver (AIC8800 USB, out-of-tree) ---
# Radxa maintains a standalone USB/SDIO/PCIe driver with proper D80 support.
# We build aic_load_fw.ko + aic8800_fdrv.ko from src/USB/driver_fw/drivers/aic8800/.
# Firmware lives in src/USB/driver_fw/fw/aic8800D80/ (same files as allwinner-target overlay).
AIC8800_REPO="https://github.com/radxa-pkg/aic8800.git"
AIC8800_BRANCH="main"
AIC8800_COMMIT="fda6713f1eebdc83ce23d9f35b6dec1abae2b2c9"

# --- NPU SDK (VIPLite / ai-sdk) ---
# VeriSilicon VIPLite userland + vpm_run inference tool + pre-built models.
# Maintained by Radxa NPU engineer (ZIFENG278).
AI_SDK_REPO="https://github.com/ZIFENG278/ai-sdk.git"
AI_SDK_BRANCH="main"
AI_SDK_COMMIT="fc90006d0f6569da2f6726c2d8395877686f5aca"

# --- Stock boot0 (extracted from Radxa official image) ---
# A733 BROM loads boot0 from SD sector 256. The boot0 in allwinner-device
# has different DRAM init params and does NOT boot on Cubie A7Z.
# We extract the known-good boot0 from the Radxa stock image instead.
RADXA_IMAGE_URL="https://github.com/radxa-build/radxa-cubie-a7z/releases/download/rsdk-b1/radxa-cubie-a7z_bullseye_kde_b1.output_512.img.xz"
RADXA_IMAGE_SHA256="d991b8bf20fb23fda160feac386decfbd54d544b95cdb95da050a2b131e038ac"
BOOT0_SECTOR=256
BOOT0_SIZE=262144
BOOT0_SHA256="ec93227f0ca2fc09a18ee92fbdab7b7a81e2effb824937bf20652d9c9cf4e69e"

# --- Toolchain (provided by the builder container) ---
CROSS_COMPILE="aarch64-linux-gnu-"
ARCH="arm64"

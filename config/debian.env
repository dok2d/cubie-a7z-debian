# Debian rootfs configuration for Cubie A7Z.
#
# NOTE: 30-build-rootfs.sh currently hardcodes most of these values.
# This file serves as documentation of intended defaults.
# TODO: migrate 30-build-rootfs.sh to use these variables.

DEBIAN_SUITE="trixie"
DEBIAN_MIRROR="http://deb.debian.org/debian"
DEBIAN_ARCH="arm64"
DEBOOTSTRAP_VARIANT="minbase"

# Default users
DEFAULT_USER="cubie"
DEFAULT_PASSWORD="cubie"
ROOT_PASSWORD="cubie"

TARGET_HOSTNAME="cubie-a7z"
TIMEZONE="UTC"
LOCALE="C.utf8"

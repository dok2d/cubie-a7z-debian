From 3bad6fca0837c5382d34c0d3ad82c24549e8356b Mon Sep 17 00:00:00 2001
From: Cubie A7Z Build <build@cubie-a7z>
Date: Sat, 20 Jun 2026 14:53:28 +0000
Subject: [PATCH] usb: typec: tcpci: rt1711h: add support for Etek ET7304

The Etek ET7304 is a USB Type-C Port Controller (TCPC) that is
register-compatible with the Richtek RT1715. It shares the same
Device ID (0x2173) but uses a different Vendor ID (0x6DCF instead
of Richtek's 0x29CF).

Add ET7304 VID to the revision check so the driver accepts the chip.
Skip the Product ID check for non-Richtek vendors since the PID
register value differs. Add the ET7304 to the I2C device ID table
and the OF match table with RT1715_DID as match data.

Upstream references:
  https://lore.kernel.org/all/20260220-et7304-v3-2-ede2d9634957@gmail.com/

Signed-off-by: Yuanshen Cao <1677399301gg@gmail.com>
[backport-6.6: adapted context for orangepi BSP kernel 6.6.98]
---
 drivers/usb/typec/tcpm/tcpci_rt1711h.c | 21 ++++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/drivers/usb/typec/tcpm/tcpci_rt1711h.c b/drivers/usb/typec/tcpm/tcpci_rt1711h.c
index 66b29d093..d80bc31bf 100644
--- a/drivers/usb/typec/tcpm/tcpci_rt1711h.c
+++ b/drivers/usb/typec/tcpm/tcpci_rt1711h.c
@@ -18,6 +18,7 @@
 
 #define RT1711H_VID		0x29CF
 #define RT1711H_PID		0x1711
+#define ET7304_VID		0x6DCF
 #define RT1711H_DID		0x2171
 #define RT1715_DID		0x2173
 
@@ -305,16 +306,20 @@ static int rt1711h_check_revision(struct i2c_client *i2c, struct rt1711h_chip *c
 	ret = i2c_smbus_read_word_data(i2c, TCPC_VENDOR_ID);
 	if (ret < 0)
 		return ret;
-	if (ret != RT1711H_VID) {
+	if (ret != RT1711H_VID && ret != ET7304_VID) {
 		dev_err(&i2c->dev, "vid is not correct, 0x%04x\n", ret);
 		return -ENODEV;
 	}
-	ret = i2c_smbus_read_word_data(i2c, TCPC_PRODUCT_ID);
-	if (ret < 0)
-		return ret;
-	if (ret != RT1711H_PID) {
-		dev_err(&i2c->dev, "pid is not correct, 0x%04x\n", ret);
-		return -ENODEV;
+
+	/* Only check PID for Richtek chips; other vendors have different PIDs */
+	if (ret == RT1711H_VID) {
+		ret = i2c_smbus_read_word_data(i2c, TCPC_PRODUCT_ID);
+		if (ret < 0)
+			return ret;
+		if (ret != RT1711H_PID) {
+			dev_err(&i2c->dev, "pid is not correct, 0x%04x\n", ret);
+			return -ENODEV;
+		}
 	}
 	ret = i2c_smbus_read_word_data(i2c, TCPC_BCD_DEV);
 	if (ret < 0)
@@ -405,6 +410,7 @@ static void rt1711h_remove(struct i2c_client *client)
 static const struct i2c_device_id rt1711h_id[] = {
 	{ "rt1711h", 0 },
 	{ "rt1715", 0 },
+	{ "et7304", 0 },
 	{ }
 };
 MODULE_DEVICE_TABLE(i2c, rt1711h_id);
@@ -413,6 +419,7 @@ MODULE_DEVICE_TABLE(i2c, rt1711h_id);
 static const struct of_device_id rt1711h_of_match[] = {
 	{ .compatible = "richtek,rt1711h", .data = (void *)RT1711H_DID },
 	{ .compatible = "richtek,rt1715", .data = (void *)RT1715_DID },
+	{ .compatible = "etekmicro,et7304", .data = (void *)RT1715_DID },
 	{},
 };
 MODULE_DEVICE_TABLE(of, rt1711h_of_match);
-- 
